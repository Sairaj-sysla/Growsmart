# ============================================================
#  .npmrc — Project npm configuration
#  Place this file in the same folder as package.json
# ============================================================

# Suppress donation/sponsorship messages on every install
fund=false

# Suppress automatic security audit on every install
# Run 'npm audit' manually when you want to check
audit=false

# Keep ^ version ranges (don't pin exact versions)
save-exact=false

# Don't show progress bar (cleaner CI logs)
progress=false

# Faster installs — don't create package-lock audit entries
prefer-offline=false